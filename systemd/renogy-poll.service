[Unit]
Description=Poll Renogy BT and write to InfluxDB
After=network-online.target bluetooth.target influxdb.service
Wants=network-online.target

[Service]
Type=oneshot
User=pi

# Hard cap the whole run (this DOES work for oneshot)
TimeoutStartSec=90
TimeoutStopSec=10
KillSignal=SIGTERM
KillMode=control-group

# If it times out, mark it as failed (good for alerting later)
TimeoutStartFailureMode=kill

# Prevent overlapping runs (important)
ExecStart=/usr/bin/flock -n /tmp/renogy-poll.lock \
  /usr/bin/env PYTHONUNBUFFERED=1 python3 -u /home/pi/solar-telemetry/renogy_poll_to_influx.py

[Install]
WantedBy=multi-user.target
